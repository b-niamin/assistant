# Copy to .env and fill in. .env is git-ignored and hidden from the claude container.

# Postgres superuser (used only by migrate/backup).
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=assistant
# POSTGRES_DB=assistant

# Per-service database roles (see db/roles.sql). Generate each with: openssl rand -hex 24
APP_DB_PASSWORD=change-me
CLAUDE_DB_PASSWORD=change-me
# Login of extension background services (role ext_<id>_svc, db/extension-role.sql).
SERVICES_DB_PASSWORD=change-me

# Fernet key extension services encrypt stored logins with (e.g. the health extension's Garmin tokens):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me

# --- web ---
# The address you open the app at, e.g. the https origin Tailscale Serve gives this host
# (https://<machine>.<tailnet>.ts.net) or http://localhost:3000 over an SSH tunnel.
PUBLIC_ORIGIN=http://localhost:3000
# Optional: the single app password, hashed. Leave empty to set it in the web wizard (/setup) instead.
# Generate (asks for the password, prints the hash):
#   docker compose run --rm -it --no-deps web node scripts/hash-password.mjs
APP_PASSWORD_HASH=
# WEB_PORT=3000
# APP_TIMEZONE=UTC
# Profile used when none is picked (Claude's tools, services). Empty = the first profile.
# DEFAULT_PROFILE=

# Extensions with a background service: install.sh writes this from extensions/installed.json.
# COMPOSE_FILE=docker-compose.yml:extensions/health/compose.yml
# Where `ext install` takes ready-made extensions from (default: github.com/b-niamin/assistant-extensions).
# EXTENSIONS_REPO=

# uid that owns this checkout on the host, so the claude container can write it.
# Synology: run `id -u` over SSH (usually 1026 for the first user).
HOST_UID=1000

# Optional: lets the claude container push its commits (fine-grained PAT, Contents r/w, your repo only).
# CLAUDE_GITHUB_TOKEN=github_pat_...

# Encrypts extension secrets (System settings > Extension secrets) in the database.
# 32+ random characters, e.g. `openssl rand -base64 33`. Changing it makes stored keys unreadable.
SECRETS_KEY=

# First-run wizard (/setup): one-time code; install.sh generates it. Not needed once APP_PASSWORD_HASH is set.
SETUP_TOKEN=

# Terminal and browser in System settings (spec 004). Signs single-use WebSocket tickets.
# Generate: openssl rand -hex 32   (empty = both sidecars refuse every connection)
SIDECAR_TICKET_SECRET=
# BROWSER_SCREEN=1366x860

# Lets Claude (Remote Control or the in-app terminal) call the extensions' tools through the assistant MCP
# server (spec 005). 32+ random characters, e.g. `openssl rand -base64 33`.
CLAUDE_TOOLS_TOKEN=
