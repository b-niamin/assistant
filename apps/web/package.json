{
  "name": "assistant-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "npm run gen && vite dev",
    "build": "npm run gen && vite build",
    "start": "node server.mjs",
    "check": "npm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run gen --silent && vitest run",
    "hash-password": "node scripts/hash-password.mjs",
    "gen": "node scripts/gen-extensions.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "postgres": "^4.1.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
